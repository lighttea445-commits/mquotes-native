{
  "permissions": {
    "allow": [
      "Bash(npx expo install @react-native-community/datetimepicker)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:api.github.com)",
      "Bash(gh repo view lighttea445-commits/v0-onboarding-flow-design --json name,description,defaultBranchRef,isPrivate)",
      "Bash(echo \"EXIT_CODE: $?\")",
      "Bash(git ls-remote https://github.com/lighttea445-commits/v0-onboarding-flow-design)",
      "Bash(git archive --remote=https://github.com/lighttea445-commits/v0-onboarding-flow-design HEAD --format=tar)",
      "Bash(tar -t)",
      "Bash(eas init --id e8da2946-21f4-4a2d-abde-a759bda58a65)",
      "Bash(node -e \"const p = require\\(''./package.json''\\); console.log\\(p.dependencies[''expo-dev-client''] || p.devDependencies?.[''expo-dev-client''] || ''NOT FOUND''\\)\")",
      "Bash(git add:*)",
      "Bash(git reset:*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"continue\": true, \"suppressOutput\": false, \"hookSpecificOutput\": {\"hookEventName\": \"Stop\", \"additionalContext\": \"This is a React Native / Expo Go app. preview_start is NOT applicable. Do not call preview_start or any preview_* tools. Verification is done by the user via Expo Go on a physical device.\"}}'"
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "supabase@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "figma@claude-plugins-official": true,
    "playwright@claude-plugins-official": false,
    "frontend-design@claude-plugins-official": false
  },
  "disabledMcpjsonServers": ["Claude_Preview", "claude-preview", "preview"]
}
