+      // PATCHED — facebook/react-native#53960, #54859.
+      //
+      // Upstream converts the NSException into a jsi::JSError and rethrows it.
+      // Both halves are unsafe for void methods:
+      //
+      //   1. convertNSExceptionToJSError() allocates JSI values on the Hermes
+      //      runtime from the native method queue, concurrently with the JS
+      //      thread. Hermes is not thread-safe, so this corrupts its heap and
+      //      the app later dies inside unrelated GC code.
+      //   2. For async void methods the rethrow escapes a dispatch block where
+      //      nothing can catch it, terminating the process outright.
+      //
+      // Confirmed by an on-device crash report (iOS 26.5.2, EXC_BAD_ACCESS on
+      // com.facebook.react.runtime.JavaScript inside GCScope::_newChunkAndPHV,
+      // while com.meta.react.turbomodulemanager.queue sat in
+      // convertNSExceptionToJSError -> convertNSArrayToJSIArray).
+      //
+      // Swallow the exception, and record module+method so JS can report which
+      // native module is actually misbehaving (WidgetBridge.getSwallowedExceptions).
+      (void)runtime;
+      NSString *offender = [NSString stringWithFormat:@"%s.%s | %@: %@",
+                                                      moduleName,
+                                                      methodNameStr.c_str(),
+                                                      exception.name,
+                                                      exception.reason];
+      RCTLogWarn(@"[TurboModule] Swallowed exception in void method %@", offender);
+      @try {
+        NSUserDefaults *store = [NSUserDefaults standardUserDefaults];
+        NSArray *previous = [store arrayForKey:@"RCTSwallowedTurboModuleExceptions"] ?: @[];
+        if (![previous containsObject:offender] && previous.count < 32) {
+          [store setObject:[previous arrayByAddingObject:offender]
+                    forKey:@"RCTSwallowedTurboModuleExceptions"];
+        }
+      } @catch (__unused NSException *ignored) {
+        // Diagnostics must never be the thing that breaks startup.
+      }
     } @finally {
       [retainedObjectsForInvocation removeAllObjects];
     }
